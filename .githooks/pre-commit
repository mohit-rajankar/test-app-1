#!/usr/bin/env bash
# ==============================================================================
# Git Central Hooks - Pre-Commit Hook
# ==============================================================================
# Gate 1: Branch Naming Validation
#   Convention: <type>/<developer>/<YYYY-MM-DD>/<description>
#   Examples:
#     feature/xyz/2026-10-15/add-login-page
#     bugfix/xyz/2026-10-15/fix-login-error
#     chore/xyz/2026-10-15/update-ci-workflow
#
# Gate 3: Check for single-letter identifiers in staged Python code
#   Validates that staged Python code conforms to readable identifier rules.
# ==============================================================================

set -e

# ------------------------------------------------------------------------------
# Gate 1: Branch Naming Validation
# ------------------------------------------------------------------------------
CURRENT_BRANCH=$(git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

RUN_BRANCH_CHECK=1

# If detached HEAD (during rebases, cherry-picks, bisects), skip branch check
if [ -z "$CURRENT_BRANCH" ] || [ "$CURRENT_BRANCH" = "HEAD" ]; then
    RUN_BRANCH_CHECK=0
fi

# Allow bypass via environment variable if emergency hotfix or automated workflow
if [ "${SKIP_BRANCH_CHECK:-0}" = "1" ]; then
    RUN_BRANCH_CHECK=0
fi

# Protected / Exempt branches that do not require the feature-branch convention.
EXEMPT_BRANCHES="^(main|master|staging|production|develop|dev|release/.*)$"
if [ "$RUN_BRANCH_CHECK" = "1" ] && echo "$CURRENT_BRANCH" | grep -Eq "$EXEMPT_BRANCHES"; then
    RUN_BRANCH_CHECK=0
fi

if [ "$RUN_BRANCH_CHECK" = "1" ]; then
    # Branch naming regex:
    # Types: feature, bugfix, hotfix, chore, docs, refactor, test
    # Developer identifier: alphanumeric, hyphens, underscores
    # Date: YYYY-MM-DD (4 digits - 2 digits - 2 digits)
    # Description: alphanumeric, hyphens, dots, underscores
    VALID_BRANCH_REGEX="^(feature|bugfix|hotfix|chore|docs|refactor|test)/[a-zA-Z0-9_-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-zA-Z0-9._-]+$"

    if ! echo "$CURRENT_BRANCH" | grep -Eq "$VALID_BRANCH_REGEX"; then
        echo "================================================================================"
        echo "❌ COMMIT REJECTED: Invalid branch name '$CURRENT_BRANCH'"
        echo "================================================================================"
        echo "Branch names must adhere to the naming convention:"
        echo "  <type>/<developer>/<YYYY-MM-DD>/<description>"
        echo ""
        echo "Allowed types:"
        echo "  feature, bugfix, hotfix, chore, docs, refactor, test"
        echo ""
        echo "Valid examples:"
        echo "  feature/xyz/2026-10-15/add-login-page"
        echo "  bugfix/xyz/2026-10-15/fix-login-error"
        echo "  chore/xyz/2026-10-15/update-ci-workflow"
        echo ""
        echo "Exempt branches:"
        echo "  main, master, staging, production, develop, dev, release/*"
        echo ""
        echo "To rename your local branch, run:"
        echo "  git branch -m <valid-branch-name>"
        echo "================================================================================"
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# Gate 3: Check for single-letter identifiers in staged Python code
# ------------------------------------------------------------------------------
if [ "${SKIP_IDENTIFIER_CHECK:-0}" != "1" ] && [ "${SKIP_SINGLE_LETTER_CHECK:-0}" != "1" ]; then
    HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
    IDENTIFIER_SCRIPT=""

    if [ -f "$HOOK_DIR/check_single_letter_identifiers.py" ]; then
        IDENTIFIER_SCRIPT="$HOOK_DIR/check_single_letter_identifiers.py"
    elif [ -f ".githooks/check_single_letter_identifiers.py" ]; then
        IDENTIFIER_SCRIPT=".githooks/check_single_letter_identifiers.py"
    elif [ -f "scripts/check_single_letter_identifiers.py" ]; then
        IDENTIFIER_SCRIPT="scripts/check_single_letter_identifiers.py"
    fi

    PYTHON_BIN=""
    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="python"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="python3"
    fi

    # Verify python binary is functional (guards against Windows Store stubs)
    if [ -n "$PYTHON_BIN" ]; then
        if ! "$PYTHON_BIN" -c "import sys" >/dev/null 2>&1; then
            PYTHON_BIN=""
        fi
    fi

    if [ -n "$PYTHON_BIN" ] && [ -n "$IDENTIFIER_SCRIPT" ]; then
        if ! "$PYTHON_BIN" "$IDENTIFIER_SCRIPT"; then
            exit 1
        fi
    fi
fi

exit 0
